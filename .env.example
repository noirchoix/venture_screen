VSI_ENVIRONMENT=production
VSI_API_PREFIX=/api/v1
VSI_DATA_DIR=/data
VSI_MAX_UPLOAD_BYTES=26214400
VSI_MAX_DOCUMENT_CHARS=120000
VSI_CORS_ORIGINS=http://localhost:5173
# Optional future narrative provider. Core scoring does not require an LLM.
VSI_LLM_PROVIDER=deepseek
VSI_LLM_API_KEY=some_api_key
VSI_LLM_MODEL=deepseek-chat
